[Unit]
Description=omatether - coding agent over chat
# Long polling needs working DNS at start, not just a configured interface.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Explicit rather than inherited: a user service does not source .bashrc, so
# without this neither `claude` nor the other mise-installed agents are found.
# node is on this PATH too: the Photon channel supervises a Node sidecar.
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin

# Channel credentials. At least one channel must be configured:
#   OMATETHER_TELEGRAM_TOKEN, OMATETHER_TELEGRAM_ALLOWED_USERS
#   OMATETHER_PHOTON_PROJECT_ID, OMATETHER_PHOTON_PROJECT_SECRET,
#   OMATETHER_PHOTON_ALLOWED_USERS
# `omatether setup` writes this file; chmod 600 — it is a shell on this
# machine.
EnvironmentFile=%h/.config/omatether/env

# Installed by the omatether package. Threads default to $HOME and /new
# steps into ~/Work, so --dir only seeds threads that never chose a place.
ExecStart=/usr/bin/omatether serve --dir %h

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
