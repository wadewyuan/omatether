# Maintainer: wadewyuan
#
# The AUR `omatether` package: built from source. After installing, run
# `omatether setup` — it writes the credentials file and starts the user
# service.
pkgname=omatether
pkgver=0.1.0
pkgrel=1
pkgdesc="Your coding agent, over chat — Telegram and iMessage bridged to the agent on this machine"
arch=('x86_64')
url="https://github.com/wadewyuan/omatether"
license=('MIT')
install=omatether.install
# makepkg's lto option compiles the bundled sqlite3.c into GCC fat-LTO
# objects that rust-lld silently drops at the final link — the binary then
# fails with undefined sqlite3_* symbols. Rust PKGBUILDs turn it off.
options=('!lto')
# systemd: the bridge runs as a user service. tmux: the detached agent tier.
depends=('gcc-libs' 'glibc' 'systemd' 'tmux')
makedepends=('cargo' 'nodejs' 'npm')
optdepends=(
  'nodejs: iMessage channel via Photon (Telegram-only installs do not need it)'
  'claude-code: Claude agent backend'
  'crush-bin: crush agent backend'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Filled in once v$pkgver is tagged: updpkgsums.
sha256sums=('SKIP')

# Everything that needs the network happens here, so build() and check()
# run offline, per the Arch Rust package guidelines.
prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"

  cd vendor/photon-sidecar
  npm ci
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release

  # One bundled file plus resolve-check stubs, not 128 MB of node_modules.
  cd vendor/photon-sidecar
  npm run bundle
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/omatether "$pkgdir/usr/bin/omatether"
  install -Dm644 contrib/omatether.service "$pkgdir/usr/lib/systemd/user/omatether.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  install -dm755 "$pkgdir/usr/lib/omatether"
  cp -a vendor/photon-sidecar/dist "$pkgdir/usr/lib/omatether/photon-sidecar"
}
