[Unit]
Description=switchboard - coding agent over chat
# Long polling needs working DNS at start, not just a configured interface.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Explicit rather than inherited: a user service does not source .bashrc, so
# without this neither `claude` nor the other mise-installed agents are found.
# node is on this PATH too: the Photon channel supervises a Node sidecar.
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin

# Channel credentials. At least one channel must be configured:
#   SWITCHBOARD_TELEGRAM_TOKEN, SWITCHBOARD_TELEGRAM_ALLOWED_USERS
#   SWITCHBOARD_PHOTON_PROJECT_ID, SWITCHBOARD_PHOTON_PROJECT_SECRET,
#   SWITCHBOARD_PHOTON_ALLOWED_USERS
# chmod 600 - these are a shell on this machine.
EnvironmentFile=%h/.config/switchboard/env

ExecStart=%h/src/switchboard/target/release/switchboard serve --dir %h/src

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
